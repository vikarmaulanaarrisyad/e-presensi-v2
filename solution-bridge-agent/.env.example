# ========================================================
# PENGATURAN KONEKSI CLOUD E-PRESENSI
# ========================================================
# Masukkan alamat URL Cloud E-Presensi madrasah Anda (misal: https://epresensi-madrasah.vercel.app atau http://localhost:3000)
EP_CLOUD_URL=http://localhost:3000

# API Key Rahasia Madrasah (Dapatkan di Menu Admin -> Mesin Fingerprint)
EP_API_KEY=fp_sec_ganti_dengan_api_key_madrasah_anda

# ========================================================
# PENGATURAN MESIN FINGERPRINT SOLUTION (LAN / WIFI)
# ========================================================
# IP Address Mesin Fingerprint di jaringan sekolah (Lihat di Mesin: Menu -> Comm / Komunikasi -> Jaringan / Ethernet)
FP_MACHINE_IP=192.168.1.201

# Port Mesin (Standar mesin Solution & ZKTeco adalah 4370)
FP_MACHINE_PORT=4370

# Timeout koneksi ke mesin (dalam milidetik)
FP_TIMEOUT=10000

# ========================================================
# JADWAL SINKRONISASI
# ========================================================
# Interval sinkronisasi otomatis dalam satuan Menit (Disarankan 2 atau 5 menit)
SYNC_INTERVAL_MINUTES=2

# Hanya sinkronkan log X hari terakhir (0 = hanya hari ini, 1 = kemarin & hari ini, 3 = 3 hari terakhir)
SYNC_DAYS_LOOKBACK=1
