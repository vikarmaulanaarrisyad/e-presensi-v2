# Supabase PostgreSQL connection
# Transaction Pooler (port 6543) or Session Pooler (port 5432)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# Direct connection to the database (used for migrations and Prisma Studio)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth.js Secret & URL
NEXTAUTH_SECRET="super-secret-random-jwt-key-replace-in-production"
# Di Vercel: Ubah dengan URL domain aplikasi Anda (misal https://e-presensi.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
# Wajib untuk Vercel agar NextAuth otomatis mengenali domain deploy
AUTH_TRUST_HOST="true"

# JWT Secret for Mobile Flutter API
JWT_SECRET="super-secret-mobile-jwt-key-change-me"

# ========================================================
# Google Cloud OAuth 2.0 (Penyimpanan Google Drive Madrasah)
# Dapatkan di Google Cloud Console -> APIs & Services -> Credentials
# Redirect URI: http://localhost:3000/api/auth/google-drive/callback (atau domain Anda)
# ========================================================
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"
