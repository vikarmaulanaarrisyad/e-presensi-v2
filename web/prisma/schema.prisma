generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  SUPERADMIN
  ADMIN_MADRASAH
  TEACHER
}

enum AttendanceStatus {
  PRESENT
  LATE
  PERMIT
  SICK
  ABSENT
  DUTY // Perjalanan Dinas / Dinas Luar (Dihitung Hadir Penuh)
}

enum PermitType {
  PERMIT
  SICK
  DUTY // Dinas Luar / Tugas Resmi
}

enum PermitStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==========================================
// MODELS
// ==========================================

model Madrasah {
  id          String   @id @default(uuid())
  nsm         String   @unique // Nomor Statistik Madrasah
  npsn        String?  @unique // Nomor Pokok Sekolah Nasional
  name        String
  address     String?  @db.Text
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Fingerprint Machine Integration (Solution / ZKTeco)
  fingerprintApiKey   String?   @unique @map("fingerprint_api_key")
  fingerprintIp       String?   @default("192.168.1.201") @map("fingerprint_ip")
  fingerprintPort     Int?      @default(4370) @map("fingerprint_port")
  fingerprintLastSync DateTime? @map("fingerprint_last_sync")

  // Google Drive Storage Integration (Per-Lembaga Gmail/Workspace)
  googleDriveEmail        String?   @map("google_drive_email")
  googleDriveRefreshToken String?   @db.Text @map("google_drive_refresh_token")
  googleDriveFolderId     String?   @map("google_drive_folder_id")
  googleDriveFolderName   String?   @map("google_drive_folder_name")
  googleDriveConnectedAt  DateTime? @map("google_drive_connected_at")
  googleDriveEnabled      Boolean   @default(false) @map("google_drive_enabled")

  // Relations
  settings            MadrasahSetting?
  users               User[]
  attendanceLogs      AttendanceLog[]
  holidays            Holiday[]
  positions           Position[]
  teachingJournals    TeachingJournal[]
  fingerprintSyncLogs FingerprintSyncLog[]
  permitRequests      PermitRequest[]

  @@map("madrasahs")
}

model MadrasahSetting {
  id              String   @id @default(uuid())
  madrasahId      String   @unique @map("madrasah_id")
  
  // Geofencing Coordinates
  latitude        Float
  longitude       Float
  radiusMeters    Float    @default(50.0) @map("radius_meters") // Default radius 50m

  // Attendance Work Hours (HH:mm format)
  workStartTime   String   @default("07:00") @map("work_start_time")
  lateThreshold   String   @default("07:15") @map("late_threshold")
  workEndTime     String   @default("14:00") @map("work_end_time")

  // Work Days & Daily Specific Hours (JSON String for Monday to Sunday)
  workDays        String   @default("1,2,3,4,5") @map("work_days")
  dailySchedules            String?  @db.Text @map("daily_schedules")
  requireSelfie             Boolean  @default(true) @map("require_selfie")
  allowBackdatedAttendance  Boolean  @default(false) @map("allow_backdated_attendance")

  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  madrasah        Madrasah @relation(fields: [madrasahId], references: [id], onDelete: Cascade)

  @@map("madrasah_settings")
}

model Holiday {
  id          String    @id @default(uuid())
  madrasahId  String    @map("madrasah_id")
  name        String
  date        DateTime  @db.Date
  endDate     DateTime? @db.Date @map("end_date") // Optional for multi-day long vacations
  isNational  Boolean   @default(false) @map("is_national")
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  madrasah    Madrasah  @relation(fields: [madrasahId], references: [id], onDelete: Cascade)

  @@index([madrasahId])
  @@index([madrasahId, date])
  @@index([madrasahId, endDate])
  @@map("holidays")
}

model Position {
  id           String   @id @default(uuid())
  madrasahId   String   @map("madrasah_id")
  name         String   // e.g. "Kepala Madrasah", "Wakil Kepala", "Guru Kelas", "Guru Mapel", "Tata Usaha"
  code         String?  // e.g. "KAMAD", "WAKAMAD", "GURU", "TU"
  description  String?  @db.Text
  isHeadmaster Boolean  @default(false) @map("is_headmaster") // Penanda khusus Kepala Madrasah
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  madrasah     Madrasah @relation(fields: [madrasahId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([madrasahId, name])
  @@index([madrasahId])
  @@index([madrasahId, order])
  @@map("positions")
}

model User {
  id                String    @id @default(uuid())
  madrasahId        String?   @map("madrasah_id") // Nullable ONLY for SUPERADMIN
  positionId        String?   @map("position_id")
  name              String
  gelarDepan        String?   @map("gelar_depan")
  gelarBelakang     String?   @map("gelar_belakang")
  email             String    @unique
  nip               String?   // Nomor Induk Pegawai
  nik               String?   // Nomor Induk Kependudukan (16 digit)
  pegId             String?   @map("peg_id") // ID Pegawai Simpatika / EMIS Kemenag
  nuptk             String?   // Nomor Unik Pendidik & Tenaga Kependidikan (16 digit)
  tempatLahir       String?   @map("tempat_lahir")
  tanggalLahir      DateTime? @db.Date @map("tanggal_lahir")
  gender            String?   // L (Laki-laki) / P (Perempuan)
  statusKepegawaian String?   @map("status_kepegawaian") // PNS / PPPK / Non-PNS / GTY / GTT
  jenisGtk          String?   @map("jenis_gtk") // Guru Mapel / Guru Kelas / Tenaga Administrasi / dll
  passwordHash      String    @map("password_hash")
  role              Role      @default(TEACHER)
  phone             String?
  avatarUrl         String?   @map("avatar_url")
  fingerprintPin    String?   @map("fingerprint_pin") // Nomor ID / PIN di Mesin Fingerprint Solution
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  madrasah        Madrasah?       @relation(fields: [madrasahId], references: [id], onDelete: Cascade)
  position        Position?       @relation(fields: [positionId], references: [id], onDelete: SetNull)
  attendanceLogs  AttendanceLog[]
  teachingJournals TeachingJournal[]
  permits         PermitRequest[] @relation("TeacherPermits")
  approvedPermits PermitRequest[] @relation("ApprovedPermits")

  @@index([madrasahId])
  @@index([positionId])
  @@index([role])
  @@index([pegId])
  @@index([nuptk])
  @@index([nip])
  @@index([nik])
  @@index([name])
  @@index([fingerprintPin])
  @@index([madrasahId, fingerprintPin])
  @@index([madrasahId, role, isActive])
  @@map("users")
}

model AttendanceLog {
  id                String           @id @default(uuid())
  madrasahId        String           @map("madrasah_id") // Multi-tenant strict isolation
  userId            String           @map("user_id")
  date              DateTime         @db.Date // YYYY-MM-DD for single check per day constraint

  // Clock-in Details
  checkInTime       DateTime?        @map("check_in_time")
  checkInLat        Float?           @map("check_in_lat")
  checkInLng        Float?           @map("check_in_lng")
  checkInDistance   Float?           @map("check_in_distance") // Distance in meters from center
  checkInPhotoUrl   String?          @map("check_in_photo_url")

  // Clock-out Details
  checkOutTime      DateTime?        @map("check_out_time")
  checkOutLat       Float?           @map("check_out_lat")
  checkOutLng       Float?           @map("check_out_lng")
  checkOutDistance  Float?           @map("check_out_distance")
  checkOutPhotoUrl  String?          @map("check_out_photo_url")

  status            AttendanceStatus @default(PRESENT)
  notes             String?          @db.Text
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  // Relations
  madrasah          Madrasah         @relation(fields: [madrasahId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // 1 user has at most 1 attendance record per calendar date
  @@index([madrasahId])
  @@index([madrasahId, date])
  @@index([userId])
  @@index([madrasahId, status])
  @@index([madrasahId, date, status])
  @@map("attendance_logs")
}

model TeachingJournal {
  id              String   @id @default(uuid())
  madrasahId      String   @map("madrasah_id")
  userId          String   @map("user_id")
  date            DateTime @db.Date // YYYY-MM-DD
  className       String   @map("class_name") // e.g. "X MIPA 1", "VII A", "Kelas 1", dll
  subjectName     String   @map("subject_name") // e.g. "Matematika", "Fiqih", "Bahasa Arab"
  sessionHours    String   @map("session_hours") // e.g. "Jam 1-2 (07:30 - 09:00)"
  topicTitle      String   @map("topic_title") // Materi Pokok / Bahasan
  activities      String   @db.Text // Uraian Aktivitas KBM
  studentPresence String?  @map("student_presence") // e.g. "Hadir: 32, Izin: 1, Alpa: 0"
  notes           String?  @db.Text // Catatan hambatan / tindak lanjut
  photoUrl        String?  @map("photo_url") // Foto dokumentasi KBM
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  madrasah        Madrasah @relation(fields: [madrasahId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([madrasahId])
  @@index([madrasahId, date])
  @@index([userId])
  @@index([userId, date])
  @@index([madrasahId, className])
  @@map("teaching_journals")
}

model FingerprintSyncLog {
  id            String   @id @default(uuid())
  madrasahId    String   @map("madrasah_id")
  syncedAt      DateTime @default(now()) @map("synced_at")
  totalRecords  Int      @default(0) @map("total_records")
  insertedCount Int      @default(0) @map("inserted_count")
  updatedCount  Int      @default(0) @map("updated_count")
  ignoredCount  Int      @default(0) @map("ignored_count")
  status        String   @default("SUCCESS") // SUCCESS, PARTIAL, FAILED
  message       String?  @db.Text
  source        String   @default("AGENT") // AGENT, MANUAL_USB, ADMS

  // Relations
  madrasah      Madrasah @relation(fields: [madrasahId], references: [id], onDelete: Cascade)

  @@index([madrasahId])
  @@index([syncedAt])
  @@map("fingerprint_sync_logs")
}

model PermitRequest {
  id              String       @id @default(uuid())
  madrasahId      String       @map("madrasah_id")
  userId          String       @map("user_id")
  type            PermitType   @default(PERMIT)
  status          PermitStatus @default(PENDING)
  startDate       DateTime     @db.Date @map("start_date")
  endDate         DateTime     @db.Date @map("end_date")
  totalDays       Int          @default(1) @map("total_days")
  notes           String       @db.Text
  attachmentUrl   String?      @map("attachment_url")
  rejectionReason String?      @map("rejection_reason") @db.Text
  approvedById    String?      @map("approved_by_id")
  approvedAt      DateTime?    @map("approved_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  madrasah        Madrasah     @relation(fields: [madrasahId], references: [id], onDelete: Cascade)
  user            User         @relation("TeacherPermits", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy      User?        @relation("ApprovedPermits", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([madrasahId])
  @@index([madrasahId, status])
  @@index([userId])
  @@index([startDate, endDate])
  @@map("permit_requests")
}

